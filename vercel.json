{
  "installCommand": "npm ci",
  "buildCommand": "npm run build:web",
  "outputDirectory": "apps/web/dist",
  "routes": [
    {
      "src": "^/(app|login|invite|shared|home|lists|purchase|history|compare|prices|markets|products|insights|billing|settings|tutorial)(/.*)?$",
      "dest": "/app-shell.html",
      "headers": { "X-Robots-Tag": "noindex, follow" }
    },
    { "handle": "filesystem" },
    {
      "src": "/.*",
      "dest": "/404.html",
      "status": 404
    }
  ]
}
